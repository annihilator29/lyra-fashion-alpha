# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build & test artifacts (generated, never commit)
*.log
*.log.txt
build_output.txt
build_*.log
build_*.txt
cart_test_*.log
test_*.log
test_*.txt
test_fail*.log
test_failure*.txt
full_*.log
full_*.txt
lint_*.log
lint_*.txt
lint_*.json
lint_errors*.json
src_lint.txt
dashboard_clean.txt
resend_test_*.log
tsc_*.txt
tsc_*.output
typescript_errors*.txt
test-results*.json
test_results*.json
test-results/
jest_output.txt
nul
